# Where the client reads incident data from:
#   unset / "mock" — synchronous read of the seeded deterministic dataset (default)
#   "api"          — fetch from this app's own /api/incidents route
# NEXT_PUBLIC_DATA_SOURCE=api

# When set, the Next.js /api/* route handlers proxy to the FastAPI backend
# (see backend/) instead of serving the local seed. Server-side only — not
# exposed to the browser. Requires the backend running (docker compose up).
# API_BASE_URL=http://localhost:8000

# Route Watch routing. With ORS_API_KEY (free at openrouteservice.org:
# 2,000 directions a day) routes come from openrouteservice; without it, or
# when it fails, from the OSRM servers below. Server-side only.
# ORS_API_KEY=
# OSRM fallback. Defaults are public demo servers meant for light use.
# ROUTING_URL=https://router.project-osrm.org
# ROUTING_FOOT_URL=https://routing.openstreetmap.de/routed-foot
